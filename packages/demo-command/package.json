{
  "name": "@baoson/dsh-web-search-demo-command",
  "version": "0.1.0",
  "description": "DeepSeek Harness slash command `/web-search-demo [query]`: runs one real search through ctx.web and renders every pipeline stage (provider selection, wire request, raw body, parsed result, governor shaping, session record, ledger) with the source location of each step. Presentation / debugging aid; adds zero model tokens.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./report": "./lib/report.js",
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "cordis.patch.yml",
    "lib/"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "web-search",
    "slash-command",
    "demo"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@baoson/dsh-web-search-governor": "workspace:*",
    "@baoson/dsh-web-shared": "workspace:*",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.7 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.7 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-web": "^0.1.0-rc.7 || ^0.2.0-rc.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  }
}
