{
  "name": "@tobedone4byme/dsh-image-retention",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin that keeps only the last N image blocks in each model request; older images are replaced with a short text placeholder. The session log is never modified.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE",
    "README.md",
    "cordis.patch.yml",
    "lib/*.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "vitest run"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "@tobedone4byme/dsh-web-shared": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.7 || ^0.2.0-rc.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SongBaoChenAlex/dsh-web-search.git",
    "directory": "packages/image-retention"
  },
  "homepage": "https://github.com/SongBaoChenAlex/dsh-web-search/tree/main/packages/image-retention#readme",
  "bugs": "https://github.com/SongBaoChenAlex/dsh-web-search/issues"
}
