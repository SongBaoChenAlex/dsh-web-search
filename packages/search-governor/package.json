{
  "name": "@baoson/dsh-web-search-governor",
  "description": "DeepSeek Harness plugin that shapes web_search results (dedupe, trim, cap), caches repeated queries and enforces a per-session search budget. Works with any search provider; adds zero tokens.",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./shape": "./lib/shape.js",
    "./budget": "./lib/budget.js",
    "./cache": "./lib/cache.js",
    "./similarity": "./lib/similarity.js",
    "./ledger": "./lib/ledger.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "LICENSE",
    "README.md",
    "cordis.patch.yml",
    "lib/*.js"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@baoson/dsh-web-shared": "workspace:*",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.7 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.7 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.7 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7 || ^0.2.0-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SongBaoChenAlex/dsh-web-search.git",
    "directory": "packages/search-governor"
  },
  "homepage": "https://github.com/SongBaoChenAlex/dsh-web-search/tree/main/packages/search-governor#readme",
  "bugs": "https://github.com/SongBaoChenAlex/dsh-web-search/issues"
}
