{
  "name": "@baoson/dsh-web-search-http",
  "version": "0.1.0",
  "description": "Generic HTTP web-search provider for the DeepSeek Harness web seam (ctx.web) with pluggable backends. Ships with Tavily (LLM-native search: answer + extracted passages); registers under the backend name so `searchProvider: tavily` selects it.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./adapter": "./lib/adapter.js",
    "./adapters/tavily": "./lib/adapters/tavily.js",
    "./package.json": "./package.json",
    "./adapters/brave": "./lib/adapters/brave.js",
    "./adapters/exa": "./lib/adapters/exa.js"
  },
  "files": [
    "LICENSE",
    "README.md",
    "cordis.patch.yml",
    "lib/"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "web-search",
    "tavily"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "vitest run"
  },
  "dependencies": {
    "@baoson/dsh-web-shared": "workspace:*",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.7 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-launch-environment": "^0.1.0-rc.7 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.7 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-web": "^0.1.0-rc.7 || ^0.2.0-rc.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  }
}
